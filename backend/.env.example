# Copia questo file in backend/.env e inserisci i tuoi valori.
# .env è in .gitignore: non committarlo mai.

# Database usato dal server (backend/prisma-client.js)
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=catalogo_user
DATABASE_PASSWORD=password
DATABASE_NAME=catalogo

# Usati dalla CLI di Prisma (backend/prisma7.config.ts): migrate, db seed, ...
DATABASE_URL=mysql://catalogo_user:password@localhost:3306/catalogo
SHADOW_DATABASE_URL=mysql://catalogo_user:password@localhost:3306/catalogo_shadow

# Chiave API Anthropic per la chat AI (backend/models/anthropic.js)
ANTHROPIC_API_KEY=sk-ant-...
